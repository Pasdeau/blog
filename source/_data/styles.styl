/* 过滤条 */
.gallery-filter
  margin: 8px 0 16px
  display: flex
  flex-wrap: wrap
  gap: 10px

.gallery-filter button
  display: inline-flex
  align-items: center
  padding: 0 .75em
  border-radius: 999px
  border: 2px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  background: var(--btn-default-bg, transparent)
  color: var(--btn-default-color, inherit)
  cursor: pointer
  font-family: inherit
  font-size: .875em
  line-height: 2
  transition: background-color .2s ease, border-color .2s ease, color .2s ease
  &:hover, &.active
    background: var(--btn-default-hover-bg, #222)
    color: var(--btn-default-hover-color, #fff)
    border-color: var(--btn-default-hover-border-color, #222)

/* 瀑布流栅格：自适应多列 */
.gallery-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))
  gap: 12px

/* 卡片 */
.gallery-grid a
  position: relative
  display: block
  border-radius: 12px
  overflow: hidden
  box-shadow: 0 2px 10px rgba(0,0,0,.06)
  transform: translateZ(0)
  transition: transform .2s, box-shadow .2s
  &:hover
    transform: translateY(-2px)
    box-shadow: 0 8px 24px rgba(0,0,0,.12)

.gallery-grid img
  width: 100%
  height: 220px       /* 统一高度便于整齐；想自由比例可删掉这行 */
  object-fit: cover
  display: block

/* 悬浮标题遮罩 */
.gallery-grid .caption
  position: absolute
  left: 0
  right: 0
  bottom: 0
  padding: 6px 10px
  font-size: 12px
  color: #fff
  background: linear-gradient(transparent, rgba(0,0,0,.55))
  opacity: 0
  transition: .2s

.gallery-grid a:hover .caption
  opacity: 1

/* 居中大头像 + 名字 + 社交图标 */
.home-hero
  text-align: center
  margin: 10vh auto 8vh
  max-width: 820px
  padding: 0 16px
  margin: 0 auto 0.4cm
  margin-bottom: 1.5cm

.home-avatar
  width: 160px
  height: 160px
  border-radius: 50%
  object-fit: cover
  display: inline-block
  box-shadow: 0 6px 24px rgba(0,0,0,.12)

.home-name
  margin: 18px 0 8px
  font-size: 2rem
  font-weight: 800
  letter-spacing: .3px
  margin: 0 0 1.2cm

.home-tagline
  margin: 0 auto 14px
  font-size: 1rem
  opacity: .8
  margin: 0 auto 0.4cm

.home-tagline:last-of-type
  margin-bottom: 1.5cm

.home-social
  display: inline-flex
  gap: 14px
  margin: 10px 0 18px
  margin-top: 0

.home-social a
  width: 38px
  height: 38px
  border-radius: 50%
  display: inline-flex
  align-items: center
  justify-content: center
  border: 1px solid rgba(0,0,0,.15)
  transition: .2s
  text-decoration: none
  color: inherit
  &:hover
    transform: translateY(-2px)
    box-shadow: 0 6px 18px rgba(0,0,0,.12)

.home-social i
  font-size: 18px

.home-actions
  display: flex
  gap: 10px
  justify-content: center
  margin-top: 6px

.btn-primary, .btn-ghost
  display: inline-block
  padding: 8px 14px
  border-radius: 999px
  text-decoration: none
  font-size: .95rem
  transition: .2s
  border: 1px solid rgba(0,0,0,.18)

.btn-primary
  background: #111
  color: #fff
  &:hover
    opacity: .9

.btn-ghost
  background: transparent
  color: inherit
  &:hover
    background: rgba(0,0,0,.06)

/* 移动端微调 */
@media (max-width: 600px)
  .home-name
    font-size: 1.6rem
  .home-avatar
    width: 132px
    height: 132px

/* Compact footer counters beside the copyright. */
.footer .footer-inner
  display: flex
  flex-flow: row nowrap
  justify-content: center
  align-items: center
  gap: 0
  text-align: center
  font-size: .92em

/* Keep the copyright and counters on one line when space allows. */
.footer .footer-inner > .copyright,
.footer .footer-inner > .footer-views,
.footer .footer-inner > .footer-online
  flex: 0 0 auto
  display: inline-flex
  align-items: center
  gap: .35em
  margin: 0
  float: none !important
  white-space: nowrap

.footer .footer-inner > :not(.copyright):not(.footer-views):not(.footer-online)
  display: none !important

.footer .copyright .author,
.footer .copyright .with-love
  display: none

.footer .footer-views::before,
.footer .footer-online::before
  content: '·'
  margin: 0 .75em
  opacity: .55

.footer .footer-online
  color: inherit

.footer .footer-online a
  border-bottom: none
  color: inherit

.footer .footer-online a:hover
  color: var(--link-hover-color, inherit)

@media (max-width: 480px)
  .footer .footer-inner
    font-size: .8em

@media (max-width: 600px)
  .home-name
    margin-bottom: 2.0rem
  .home-hero .home-tagline:last-of-type
    margin-bottom: 2.5rem

/* 2D Interactive Pixel Pet (Oneko) Particles */
.oneko-tooltip
  position: fixed
  z-index: 1000000
  width: max-content
  max-width: 18em
  padding: .4em .65em
  border: 1px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  border-radius: 10px
  background: var(--body-bg-color, #fff)
  color: var(--body-text-color, #333)
  box-shadow: 0 2px 10px rgba(0,0,0,.12)
  font-size: .8125em
  line-height: 1.5
  white-space: normal
  pointer-events: none

.oneko-tooltip[hidden]
  display: none !important

.oneko-heart
  position: fixed
  pointer-events: none
  color: #ff4757
  font-size: 18px
  font-weight: bold
  z-index: 999999
  animation: heart-pop 1s cubic-bezier(0.215, 0.61, 0.355, 1) forwards

@keyframes heart-pop
  0%
    opacity: 1
    transform: scale(0.6) translateY(0)
  50%
    opacity: 1
    transform: scale(1.3) translateY(-20px)
  100%
    opacity: 0
    transform: scale(1) translateY(-40px)

/* 博客主题分类导航与列表样式 (Thematic Post Lists) */
.topic-nav-pills
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin: 0 0 2em

.topic-nav-pill
  display: inline-flex
  align-items: center
  gap: .4em
  padding: 0 .75em
  border: 2px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  border-radius: 999px
  background: var(--btn-default-bg, transparent)
  color: var(--btn-default-color, inherit) !important
  font-size: .875em
  line-height: 2
  text-decoration: none !important
  transition: background-color .2s ease, border-color .2s ease, color .2s ease

.topic-nav-pill:hover,
.topic-nav-pill[aria-current="page"]
  background: var(--btn-default-hover-bg, #222)
  color: var(--btn-default-hover-color, #fff) !important
  border-color: var(--btn-default-hover-border-color, #222)

.topic-groups[hidden],
.topic-category-section[hidden],
.topic-post-list[hidden],
.topic-timeline[hidden]
  display: none !important

.topic-category-section
  margin-bottom: 2em

.topic-category-header
  display: flex
  align-items: center
  gap: .5em
  margin: 1.5em 0 .75em
  font-size: 1.375em
  font-weight: 700

.topic-category-link
  display: inline-flex
  align-items: center
  gap: .5em
  border-bottom: none
  color: inherit !important
  text-decoration: none !important

.topic-category-link:hover,
.topic-category-link[aria-current="location"]
  color: var(--theme-color, inherit) !important

.topic-category-link:hover
  text-decoration: underline !important

.topic-category-header i
  color: var(--theme-color, inherit)
  font-size: 1em

.topic-category-header .badge
  font-size: .65em
  font-weight: normal
  opacity: .65

/* Series Subheaders */
.topic-series-header
  font-size: 1.125em
  font-weight: 700
  margin: 1.25em 0 .4em
  display: flex
  align-items: center
  text-align: left !important

.topic-series-link
  border-bottom: none
  color: inherit !important
  text-decoration: none !important

.topic-series-link:hover,
.topic-series-link[aria-current="location"]
  color: var(--theme-color, inherit) !important
  text-decoration: underline !important

.topic-post-list
  list-style: none !important
  padding: 0 !important
  margin: 0 0 1.25em !important

.topic-post-item
  display: flex
  flex-direction: column
  padding: .55em 0 .75em
  border-bottom: 1px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  gap: .15em
  text-align: left !important
  align-items: flex-start !important

.topic-post-main
  display: grid
  grid-template-columns: 5.5em minmax(0, 1fr)
  align-items: baseline
  gap: .75em
  text-align: left !important
  width: 100%

.topic-post-date
  font-size: .8125em
  opacity: .7
  text-align: left !important

.topic-post-title
  font-size: 1em
  font-weight: normal
  color: var(--link-color, inherit)
  text-decoration: none !important
  text-align: left !important

.topic-post-title:hover
  color: var(--link-hover-color, #222)
  text-decoration: underline !important

.topic-post-tags
  display: inline-flex
  flex-wrap: wrap
  gap: .4em
  margin: 0 0 0 6.25em

.topic-tag-pill
  display: inline-flex
  align-items: center
  font-size: .8125em
  line-height: 1.4
  padding: .15em .6em
  border: 1px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  border-radius: 999px
  background: var(--btn-default-bg, transparent)
  color: var(--btn-default-color, inherit) !important
  text-decoration: none !important
  white-space: nowrap
  transition: background-color .2s ease, border-color .2s ease, color .2s ease

.topic-tag-pill:hover,
.topic-tag-pill:focus-visible
  background: var(--btn-default-hover-bg, #222)
  color: var(--btn-default-hover-color, #fff) !important
  border-color: var(--btn-default-hover-border-color, #222)

.topic-post-task
  font-size: 1em
  line-height: 1.8
  margin-left: 6.25em
  text-align: left !important

@media (max-width: 768px)
  .topic-post-main
    display: flex
    flex-direction: column
    align-items: flex-start !important
    gap: .1em
  .topic-post-task
    margin-left: 0
    text-align: left !important
  .topic-post-tags
    margin-left: 0

/* 表格内容上下左右居中 */
.post-body table th,
.post-body table td
  text-align: center !important
  vertical-align: middle !important

/* Hexo renders highlighted code blocks as tables. */
.post-body figure.highlight td.code
  text-align: left !important
  vertical-align: top !important

.post-body figure.highlight td.gutter
  text-align: right !important
  vertical-align: top !important

.online-map-panel
  margin: 1.25em 0 .75em

.online-map-count
  margin-bottom: .75em
  font-size: 1.1em

.online-map-count span
  font-size: 1.5em
  font-weight: 600

.online-map
  overflow: hidden
  border: 1px solid var(--btn-default-border-color, rgba(128,128,128,0.25))
  border-radius: .6em
  background: var(--content-bg-color, transparent)
  text-align: center

.online-map svg
  display: block
  width: 100%
  height: auto

.online-map-country
  fill: #dbe5ea
  stroke: #fff
  stroke-width: .65

.online-map-country.is-active
  fill: #a9c8d9

.online-map-dot
  fill: #d3524a
  stroke: #fff
  stroke-width: 2

.online-map-locations
  margin-top: .5em
  font-size: .875em
  opacity: .75

html[data-theme="dark"] .online-map-country
  fill: #37424c
  stroke: #262f38

html[data-theme="dark"] .online-map-country.is-active
  fill: #537b92
